# Copy to .env or export environment variables. Never commit a real .env.
PIPELINE_DATABASE=data/kbeauty.sqlite3
PIPELINE_SNAPSHOT_DIR=data/snapshots
PIPELINE_TIMEZONE=Asia/Seoul
# Required before live collection; replace with the site's real public URL.
PIPELINE_SITE_URL=
PIPELINE_BOT_NAME=SeoulBeautyPrice
# Deliberately unset: select models after checking official docs/prices.
MODEL_EXTRACT=
MODEL_EXTRACT_RETRY=
MODEL_ANALYST=
GEMINI_API_KEY=
# Optional OpenAI-compatible gateway for analysis only. No credentials in web/.
PIPELINE_ANALYST_PROVIDER=google_genai
PIPELINE_ANALYST_BASE_URL=
ANALYST_API_KEY=
# Obtain actual gateway tariffs; leave unset to block automatic paid jobs.
# PIPELINE_AI_INPUT_USD_PER_MILLION=0.00
# PIPELINE_AI_OUTPUT_USD_PER_MILLION=0.00
PIPELINE_CRAWL_LIMIT=100
PIPELINE_CRAWL_REQUIRE_KST_WINDOW=true
PIPELINE_SOURCE_NAMES=babitalk,yeoshin
PIPELINE_DAILY_AI_BUDGET_USD=5.00
PIPELINE_ANALYST_TOKEN_LIMIT=30000
PIPELINE_CONTACT_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HEALTHCHECKS_URL=
